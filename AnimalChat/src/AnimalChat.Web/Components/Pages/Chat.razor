@page "/chat/{Id:int}"
@using AnimalChat.Web.Models
@using AnimalChat.Web.Services
@attribute [StreamRendering(true)]

@inject ImageService ImageService
@inject ChatService ChatService

<PageTitle>Dyr</PageTitle>

<h3>Chat med @_image.Description</h3>

<div class="col-md-4 mb-4">
    <div class="card h-100 shadow-sm">
        <img class="card-img-top" src="@GetImageSrc(_image.Data)" alt="@_image.Description" />
        <div class="card-body">
            <p class="card-text">@_image.AnimalName</p>

        </div>
    </div>
</div>
<section class="flex-grow-1">
    <ChatPane @ref="@ChatPane" CurrentSession="@CurrentSession" />
</section>

@code {

    [Parameter]
    public EventCallback<string> OnChatUpdated { get; set; } = default!;
    
    [Parameter]
    public int Id { get; set; }

    private static readonly Random Random = new Random();
    private ChatPane? ChatPane = default;
    public Session? CurrentSession;


    private Image _image = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id == 0)
        {
            Id = Random.Next(1, 21);
        }
        _image = await ImageService.GetImageAsync(Id);
        ChatPane = new ChatPane();
        await this.InvokeAsync(async () =>
        {
            await LoadCurrentChatAsync();
            if (CurrentSession != null) ChatPane.ChangeCurrentChatSession(CurrentSession);
            this.StateHasChanged();
        });
    }

    private async Task LoadCurrentChatAsync()
    {
        CurrentSession = await ChatService.CreateNewChatSession(_image.AnimalName);
    }

    private static string GetImageSrc(byte[] imageData)
    {
        if (imageData.Length == 0)
        {
            return string.Empty;
        }
        var base64Data = Convert.ToBase64String(imageData);
        return $"data:image/jpeg;base64,{base64Data}";
    }
}
